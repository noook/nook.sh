{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nook-sh",
  "compatibility_date": "2025-07-15",
  "pages_build_output_dir": "dist",
  // @nuxt/content requires a D1 database on Cloudflare (binding name must
  // be "DB" - it's hardcoded by @nuxt/content's cloudflare preset).
  // database_id is templated in from CF_D1_DATABASE_ID at build time by
  // scripts/generate-wrangler-config.mjs - see that script and README's
  // Deployment section. Never hardcode the real id in this template file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nook-sh-content",
      "database_id": "__CF_D1_DATABASE_ID__",
    },
  ],
}
